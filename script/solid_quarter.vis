/vis/viewer/set/lineSegmentsPerCircle 120

/vis/viewer/set/viewpointThetaPhi 60 225
/vis/viewer/set/lightsThetaPhi 40 50
/vis/viewer/zoom 1.5

# like solid_slice.vis, but cut away a 90 deg wedge instead of half:
# union mode draws what is on the normal side of either plane, so the x<0, y<0 quadrant is removed
# if the wrong quadrant is removed, flip a normal (-1 0 0 or 0 -1 0)
/vis/viewer/set/cutawayMode union
/vis/viewer/addCutawayPlane 0  0  0  cm 1 0 0
/vis/viewer/addCutawayPlane 0  0  0  cm 0 1 0

/vis/scene/add/axes 0 -3 -3.5 1 m

/vis/scene/add/scale 1 m z 0 0 1 manual  1 -3 0 m
